{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galata-wind-isg-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Pilot aşaması: henüz özel alan adı yok, workers.dev üzerinden erişiliyor.
  // Özel alan adı bağlanınca burayı false yapıp routes'u ekleyin.
  "workers_dev": true,
  "preview_urls": false,
  // "routes": [
  //   { "pattern": "isg.ORNEK-ALAN-ADI.com.tr", "custom_domain": true }
  // ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "isg-portal-pilot", "database_id": "1eb48b61-7193-4cb5-9618-07d2a38f02b4" }
  ],

  "vars": {
    // Zero Trust > Settings > Custom Pages bölümündeki takım alan adı
    "TEAM_DOMAIN": "green-firefly-c395.cloudflareaccess.com",
    // Access uygulamasının "Application Audience (AUD) Tag" değeri
    "POLICY_AUD": "603a0396b3081a0fb531adce75854cdafcddb80884395909bc52f307367a6b1e",
    // İlk yönetici zaten Yönetim Paneli üzerinden eklendi; boş bırakılır
    "ADMIN_EMAILS": "",
    // E-postalardaki "Portalda aç" bağlantısı
    "PORTAL_URL": "https://galata-wind-isg-pilot.ozanalemdar.workers.dev"
  },
  // E-posta secret'ları (GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET, MAIL_FROM)
  // burada değil, Worker > Settings > Variables and Secrets altında "Secret" olarak tutulur.
  // Graph hazır değilken geçici olarak RESEND_API_KEY (ve alan adı doğrulandıysa RESEND_FROM) secret'ı
  // girilirse e-postalar Resend ile, yalnızca konu ve portal bağlantısıyla gönderilir.

  // 5 dakikada bir e-posta kuyruğu; hafta içi 09:00 (TR) DÖF termin hatırlatmaları
  "triggers": { "crons": ["*/5 * * * *", "0 6 * * 1-5"] },

  "observability": { "enabled": true }
}
